SECTORS_API_KEY=your-sectors-api-key-here
SECTORS_BASE_URL=https://api.sectors.app/v2
CACHE_TTL_SECONDS=900


ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
DEBUG=false

# --- admin authentication ---
# Viewing the app is public. This password is only for admin/edit routes.
# Leave empty to disable admin login entirely.
APP_PASSWORD=change-me-to-a-long-random-password
# Optional: set to keep tokens valid across restarts (any long random string).
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=43200
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300

# --- user accounts ---
# SQLite file for registered users (created automatically on first run).
USERS_DB_PATH=users.db

# --- user history (Supabase) ---
# Run backend/supabase/schema.sql in the Supabase SQL editor first.
# Use a secret key (Settings -> API Keys -> "Secret keys", starts with sb_secret_).
# The legacy service_role key (eyJ...) also works. Keep it server-side, never in the frontend.
# Leave empty to disable history.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
