SECTORS_API_KEY=your-sectors-api-key-here
SECTORS_BASE_URL=https://api.sectors.app/v2
CACHE_TTL_SECONDS=900


ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
DEBUG=false

# --- admin authentication ---
# Viewing the app is public. This password is only for admin/edit routes.
# Leave empty to disable admin login entirely.
APP_PASSWORD=change-me-to-a-long-random-password
# Optional: set to keep tokens valid across restarts (any long random string).
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=43200
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
